<mujoco>
    <include file="../scene/basic_scene.xml"/>
    <include file="../objects/assets/handle_press_dependencies.xml"/>
    <include file="../objects/assets/xyz_base_dependencies.xml"/>

    <worldbody>
      <include file="../objects/assets/xyz_base.xml"/>

      <!-- Normal handle press (front-facing) -->
      <body name="box" pos="0 0.88 0">
        <body childclass="hdlprs_base" name="hdlprs">
          <geom material="hdlprs_metal0" mesh="handle_press_base"/>
          <geom material="hdlprs_black" euler="0 1.57 0" mesh="handle_press_trim"/>
          <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col1" pos="0.055 0 0" type="mesh"/>
          <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col2" pos="-0.066 0 0" type="mesh"/>
          <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col3" pos="-0.009 0 0" type="mesh"/>
          <geom class="hdlprs_col" pos="0 -0.082 0.014" size="0.035 0.028 0.014" type="box"/>
          <body name="handle_link" pos="0 -0.05 0.15">
              <joint name="handleJoint" type="slide" axis="0 0 1" range="-.1 0" damping="30" limited="true"/>
              <site name="handleStart" pos="0 -0.166 0.022" size="0.005" rgba="0.8 0 0 1"/>
              <site name="handleRight" pos="0.05 -0.166 0.014" size="0.005" rgba="0 0.8 0 1"/>
              <site name="handleCenter" pos="0 -0.12 0.0" size="0.01" rgba="0 0.8 0 1"/>
              <geom material="hdlprs_red" euler="0 1.57 0" mesh="handle_press_grip" pos="0 -0.166 0"/>
              <geom material="hdlprs_black" mesh="handle_press_lever" pos="0 -0.089 0"/>
              <geom class="hdlprs_col" pos="0 -0.081 0" size="0.032 0.075 0.011" type="box" mass=".001"/>
              <geom class="hdlprs_col" euler="0 1.57 0" pos="0 -0.166 0" size="0.022 0.07" type="cylinder" mass=".001"/>
          </body>
        </body>
        <site name="goalPress" pos="0 -0.216 0.075" size="0.005" rgba="1 1 1 0"/>
        <site name="goalPull" pos="0 -0.216 0.172" size="0.005" rgba="0 0 0 0"/>
      </body>

      <!-- Sideways handle press (rotated 90 deg around Z) -->
      <body name="box_side" euler="0 0 1.57" pos="-.4 0.6 0">
        <body childclass="hdlprs_base" name="hdlprs_side">
          <geom material="hdlprs_metal0" mesh="handle_press_base"/>
          <geom material="hdlprs_black" euler="0 1.57 0" mesh="handle_press_trim"/>
          <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col1" pos="0.055 0 0" type="mesh"/>
          <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col2" pos="-0.066 0 0" type="mesh"/>
          <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col3" pos="-0.009 0 0" type="mesh"/>
          <geom class="hdlprs_col" pos="0 -0.082 0.014" size="0.035 0.028 0.014" type="box"/>
          <body name="handle_link_side" pos="0 -0.05 0.15">
              <joint name="handleJointSide" type="slide" axis="0 0 1" range="-.1 0" damping="30" limited="true"/>
              <site name="handleStartSide" pos="0 -0.166 0.022" size="0.005" rgba="0.8 0 0 1"/>
              <site name="handleRightSide" pos="0.05 -0.166 0.014" size="0.005" rgba="0 0.8 0 1"/>
              <site name="handleCenterSide" pos="0 -0.12 0.0" size="0.01" rgba="0 0.8 0 1"/>
              <geom material="hdlprs_red" euler="0 1.57 0" mesh="handle_press_grip" pos="0 -0.166 0"/>
              <geom material="hdlprs_black" mesh="handle_press_lever" pos="0 -0.089 0"/>
              <geom class="hdlprs_col" pos="0 -0.081 0" size="0.032 0.075 0.011" type="box" mass=".001"/>
              <geom class="hdlprs_col" euler="0 1.57 0" pos="0 -0.166 0" size="0.022 0.07" type="cylinder" mass=".001"/>
          </body>
        </body>
        <site name="goalPressSide" pos="0 -0.216 0.075" size="0.005" rgba="1 1 1 0"/>
        <site name="goalPullSide" pos="0 -0.216 0.172" size="0.005" rgba="0 0 0 0"/>
      </body>

      <!-- Goal visualization site -->
      <site name="goal" pos="0 0 0" size="0.01" rgba="1 0 0 0.5"/>
    </worldbody>

    <actuator>
        <position ctrllimited="true" ctrlrange="-1 1" joint="r_close" kp="400" user="1"/>
        <position ctrllimited="true" ctrlrange="-1 1" joint="l_close" kp="400" user="1"/>
    </actuator>
    <equality>
        <weld body1="mocap" body2="hand" solref="0.02 1"></weld>
    </equality>
</mujoco>
